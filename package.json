    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.44.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
