    "autocannon": "^8.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "prisma": "^6.19.3",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
