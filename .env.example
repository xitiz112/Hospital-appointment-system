# PostgreSQL — must be named DATABASE_URL (Prisma schema env("DATABASE_URL")).
# Local Docker: postgresql://hospital:hospital@localhost:5432/hospital?schema=public
# Prisma Postgres: paste the postgres://...@db.prisma.io/... URL here (not DB_DATABASE_URL).
DATABASE_URL="postgresql://hospital:hospital@localhost:5432/hospital?schema=public"

# App
# Production must be a full URL with host (never empty / never "http://"):
# APP_URL="https://hospital-appointment-system-lyart.vercel.app"
APP_URL="http://localhost:3000"
NODE_ENV="development"
TZ="Asia/Kathmandu"

# Auth.js (admin dashboard cookies)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Local only. On Vercel leave AUTH_URL unset (or set it to https://your-app.vercel.app).
# Never set AUTH_URL=http://localhost:3000 in production — login will not reach /dashboard.
AUTH_URL="http://localhost:3000"

# Mobile-ready API JWTs
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Cron (Authorization: Bearer <CRON_SECRET>)
# On Vercel Hobby: only 1 run/day is allowed. vercel.json uses "0 3 * * *" (03:00 UTC ≈ 08:45 Nepal).
# Set the same CRON_SECRET in Vercel env — Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-cron-secret"
# How far ahead to look for appointments when the cron runs (24 = next day of visits)
REMINDER_HOURS="24"

# Optional FCM legacy server key — if empty, in-app Notification rows are still stored.
# Get from Firebase Console → Project settings → Cloud Messaging (Cloud Messaging API (Legacy)).
FCM_SERVER_KEY=""

# Email (password reset). Prefer Resend on Vercel; SMTP works for self-hosted.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Hospital <onboarding@resend.dev>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# Password reset → Expo app only (email uses https bridge /open-reset, then deep link).
# APP_URL must be full production URL.
# Expo Go:
# PASSWORD_RESET_URL_TEMPLATE="exp://192.168.1.10:8081/--/reset-password?token={token}"
# NEXT_PUBLIC_PASSWORD_RESET_URL_TEMPLATE="exp://192.168.1.10:8081/--/reset-password?token={token}"
# Installed apps (defaults):
# PATIENT_APP_SCHEME="patienthospital"
# DOCTOR_APP_SCHEME="doctorhospital"
# NEXT_PUBLIC_PATIENT_APP_SCHEME="patienthospital"
# NEXT_PUBLIC_DOCTOR_APP_SCHEME="doctorhospital"

# eSewa v2 sandbox
ESEWA_PRODUCT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_FORM_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
ESEWA_STATUS_URL="https://rc.esewa.com.np/api/epay/transaction/status/"
ESEWA_SUCCESS_URL="http://localhost:3000/api/v1/payments/esewa/success"
ESEWA_FAILURE_URL="http://localhost:3000/api/v1/payments/esewa/failure"

# Khalti sandbox
KHALTI_SECRET_KEY=""
KHALTI_PUBLIC_KEY=""
KHALTI_INITIATE_URL="https://dev.khalti.com/api/v2/epayment/initiate/"
KHALTI_LOOKUP_URL="https://dev.khalti.com/api/v2/epayment/lookup/"
KHALTI_RETURN_URL="http://localhost:3000/api/v1/payments/khalti/return"

# CORS for later Expo / React Native
CORS_ORIGINS="http://localhost:8081,http://localhost:19006,exp://localhost:8081"

# Storage
# Local disk (dev). On Vercel, set BLOB_READ_WRITE_TOKEN instead — the app
# auto-switches to Vercel Blob when that token is present.
UPLOAD_DIR="uploads"
# Bytes or units: 10485760, 10mb, 10MB. Do NOT set "2" for 2MB — use "2mb".
MAX_UPLOAD_BYTES="10mb"
# Required on Vercel for image uploads. Create Blob store with Access = Public
# (Vercel defaults to Private — that breaks public logo URLs).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Optional: force private store mode (images served via /api/v1/blob/...)
# BLOB_ACCESS="private"
